# Copy to .env.local and fill in what you need. Everything is optional:
# with no variables set, the app, the free API, the analyst (rules only) and MCP all work.
# Testnet only. Never put a mainnet or personal key here.

# Live scripts (scripts/live-slice.ts, flip-proof.ts, capture-session.ts, mpp-buy-report.ts).
# Any fresh key works; the scripts fund it from the Tempo testnet faucet.
KORRIN_TESTNET_PRIVATE_KEY=
KORRIN_TESTNET_TAKER_KEY=

# Korrin Analyst: optional Claude wording on top of the deterministic answers.
ANTHROPIC_API_KEY=

# Paid MPP report (/v1/intelligence/markets/{id}/health). All three plus a store are needed,
# otherwise the route answers 503 PAYMENT_NOT_CONFIGURED.
MPP_SECRET_KEY=            # at least 32 bytes, e.g. `openssl rand -base64 32`
KORRIN_MPP_RECIPIENT=      # testnet address that receives pathUSD payments
KORRIN_MPP_PRICE=0.01      # pathUSD per report

# Shared store for payment replay protection and report retrieval (Upstash Redis).
# The Vercel Marketplace integration sets the KV_* names; either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: enables WalletConnect in the wallet modal.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
